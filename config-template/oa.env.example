# ============================================================
# OA 二开完整环境变量模板（脱敏）
# 用法：deploy.sh 会自动复制本文件为项目根 .env 并生成随机密钥；
#       手动方式：cp 本文件为 .env，替换所有 <CHANGE_ME_*>。
# 警告：真实 .env 含数据库/端口/密钥，绝对不要提交到 Git。
# ============================================================

# ---------- 基础镜像（官方版本，按需升级） ----------
MONGO_IMAGE=mongo:7.0.28
REDIS_IMAGE=redis:7.0.0
KAFKA_IMAGE=bitnamilegacy/kafka:3.5.1
MINIO_IMAGE=bitnamilegacy/minio:2024.1.13
PROMETHEUS_IMAGE=prom/prometheus:v2.51.2
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0
GRAFANA_IMAGE=grafana/grafana:11.0.1
ETCD_IMAGE=bitnamilegacy/etcd:3.5.21
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.7.0
OPENIM_WEB_FRONT_IMAGE=openim/openim-web-front:release-v3.8.3
OPENIM_ADMIN_FRONT_IMAGE=openim/openim-admin-front:release-v1.8.4-patch.2
OPENIM_SERVER_IMAGE=openim/openim-server:v3.8.3-patch.18
OPENIM_CHAT_IMAGE=openim/openim-chat:v1.8.4-patch.5
LIVEKIT_IMAGE=livekit/livekit-server:v1.8.4
LIVEKIT_URL=ws://<CHANGE_ME_HOST>:7880

DATA_DIR=./

# ---------- 数据库 / 缓存 / 消息（改密码） ----------
MONGO_ADDRESS="mongo:27017"
MONGO_ROOT_PASSWORD=<CHANGE_ME_MONGO_ROOT_PASSWORD>
MONGO_USERNAME=openIM
MONGO_PASSWORD=<CHANGE_ME_MONGO_PASSWORD>
REDIS_ADDRESS="redis:6379"
REDIS_PASSWORD=<CHANGE_ME_REDIS_PASSWORD>
ETCD_ADDRESS="etcd:2379"
# etcd 认证四变量要么全填、要么全留空（留空=不启用认证）
ETCD_ROOT_USER=
ETCD_ROOT_PASSWORD=
ETCD_USERNAME=
ETCD_PASSWORD=
KAFKA_ADDRESS="kafka:9094"
# kafka 认证默认关闭；需要时同时设 KAFKA_USERNAME/KAFKA_PASSWORD
KAFKA_USERNAME=
KAFKA_PASSWORD=

# ---------- 对象存储 MinIO ----------
MINIO_EXTERNAL_ADDRESS="http://<CHANGE_ME_HOST>:10005"
MINIO_INTERNAL_ADDRESS="minio:9000"
MINIO_ACCESS_KEY_ID=root
MINIO_SECRET_ACCESS_KEY=<CHANGE_ME_MINIO_SECRET>
MINIO_PORT=10005
MINIO_CONSOLE_PORT=10004

# OpenIM 服务鉴权 secret（必须与 config/chat-rpc-admin.yml 一致）
OPENIM_SECRET=<CHANGE_ME_OPENIM_SECRET>

# ---------- 端口 ----------
OPENIM_API_PORT=10002
OPENIM_MSG_GATEWAY_PORT=10001
CHAT_API_PORT=10008
ADMIN_API_PORT=10009
OPENIM_WEB_FRONT_PORT=11001
OPENIM_ADMIN_FRONT_PORT=11002
PROMETHEUS_PORT=19090
ALERTMANAGER_PORT=19093
GRAFANA_PORT=13000
NODE_EXPORTER_PORT=19100

API_URL="http://openim-server:10002"
LOG_IS_STDOUT=true
LOG_LEVEL=3
GRAFANA_URL="http://127.0.0.1:13000/"

# ============================================================
# OA 业务服务（二开部分）
# ============================================================
XINBO_OA_IMAGE=xinbo-oa:local
XINBO_OA_PORT=10010
# OA 前端页面端口（容器 nginx 80 映射到宿主机）
XINBO_OA_WEB_IMAGE=xinbo-oa-web:local
XINBO_OA_WEB_PORT=5173
XINBO_OA_MONGO_URI="mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@mongo:27017/openim_v3?authSource=openim_v3"
XINBO_OA_MONGO_DB=openim_v3
# 必须与 chat 的 config/chat-rpc-admin.yml 里 secret 一致（chatToken 用它签发）
XINBO_OA_TOKEN_SECRET=<CHANGE_ME_OA_TOKEN_SECRET>
XINBO_OA_COMPANY_ID=xinbo

# OA 附件与打卡照片：复用 IM 的 MinIO，单独桶（桶名必须 >=3 字符）
XINBO_OA_MINIO_ENDPOINT=minio:9000
XINBO_OA_MINIO_BUCKET=xinbo-oa
XINBO_OA_FILE_MAX_MB=20

# ---------- 打卡定位（默认不预设公司地址） ----------
# 留空 = 只记录员工真实 GPS 坐标，不判打卡范围、不显示任何公司名。
# 需要范围判定时再填（坐标用 GCJ-02，腾讯/高德同坐标系）：
XINBO_OA_OFFICE_LAT=
XINBO_OA_OFFICE_LNG=
XINBO_OA_OFFICE_NAME=
XINBO_OA_OFFICE_ADDRESS=
XINBO_OA_OFFICE_RADIUS=500
# true=超出半径拒卡；false=照常打卡但标注「范围外」
XINBO_OA_STRICT_FENCE=false
# 腾讯位置服务 key（仅服务端用，坐标转街道地址）；留空则只显示坐标
XINBO_OA_MAP_KEY=

# ---------- 作息规则（首次启动的默认值）----------
# 管理员在「员工与权限 → 考勤规则」里保存过之后，以库里的规则为准，这里只作兜底。
XINBO_OA_WORK_ON_TIME=09:05
XINBO_OA_WORK_OFF_TIME=18:00
XINBO_OA_LATE_GRACE_MIN=0
XINBO_OA_WORK_EARLIEST_ON=06:30

# ---------- 补卡限制（同上，规则页可改）----------
XINBO_OA_MAKEUP_MAX_DAYS=7
XINBO_OA_MAKEUP_MAX_MONTH=3

# ---------- 考勤异常自动扫描 ----------
# true=服务启动后每 30 分钟扫最近 3 天（停机漏的会自动补齐）；false=只能手动触发
XINBO_OA_AUTO_SCAN=true

# ---------- IM 推送（可选）----------
# 审批待办、催交、异常认定的通知除了落站内信，还会 POST 到这里：
#   {"recv_id":"<userID>","title":"...","content":"...","path":"/report"}
# 留空则只发站内信（接口会如实返回 pushed=false，不会假装推送成功）。
XINBO_OA_IM_PUSH_URL=
XINBO_OA_IM_PUSH_TOKEN=
