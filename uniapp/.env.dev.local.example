# 复制本文件为 .env.dev.local 后生效。
#   Copy-Item .env.dev.local.example .env.dev.local
# 该文件已被 .gitignore 忽略，只属于这台机器，不要提交。
#
# 用途：本机临时 token、指向别人的后端、改端口等“不适合提交”的东西。
#
# 生成一个本地联调 token（key 必须与后端 OA_TOKEN_SECRET 一致）：
#   node ../.local/mint-token.js
# 或者用仓库根目录已有的脚本：see .local/mint-token.js
#
# 注意：token 是 HMAC 签名的登录态，等同于密码，别写进任何提交的文件。

VITE_DEV_TOKEN=
VITE_DEV_USER_ID=

# 例：连同事机器上的后端
# VITE_PROXY_OA=http://192.168.1.20:10010
