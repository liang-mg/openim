map $http_upgrade $oa_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name ${OA_TLS_DOMAIN};
    return 308 ${OA_TLS_REDIRECT_ORIGIN}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${OA_TLS_DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100m;

    resolver 127.0.0.11 valid=2s ipv6=off;
    location / {
        set $oa_upstream http://oa-web:80;
        proxy_pass $oa_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $oa_connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
